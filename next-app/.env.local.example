# Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3339

# Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Pusher (real-time WebSocket)
NEXT_PUBLIC_PUSHER_APP_KEY=
