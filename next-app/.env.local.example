NEXT_PUBLIC_PUSHER_WS_HOST=
NEXT_PUBLIC_PUSHER_WS_PORT=
NEXT_PUBLIC_PUSHER_FORCE_TLS=true

# Auth cookie
AUTH_COOKIE_NAME=bullpay_token
AUTH_COOKIE_SECRET=change-this-to-a-random-secret
